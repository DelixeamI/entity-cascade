# Only the API key is read from the environment (by OpenAICompatibleLLM; the variable name is
# llm.api_key_env in configs/default.yaml). Everything else (base_url, model, timeout_s,
# max_concurrency, prompt_version, min_confidence) lives in configs/default.yaml.
# Ollama ignores the key: leave it empty and no Authorization header is sent.
LLM_API_KEY=